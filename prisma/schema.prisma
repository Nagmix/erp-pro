// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// INF: نماذج قالب Prisma (User/Post) حُذفت — كانت معلنة وغير مستخدمة في منطق ERP Pro

/// مرآة JSON لإعدادات التكاملات المحلية — بالإضافة إلى الملف (M-20).
model AppLocalSettings {
  id        String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

/// سجل تدقيق محلي للتطبيق — التوسيع التدريجي يبدأ هنا (M-20).
model AppAuditLog {
  id        String   @id @default(cuid())
  action    String
  subject   String?
  payload   String?
  createdAt DateTime @default(now())
}

/// نسخة احتياطية لبوابة المطور في SQLite — بالإضافة إلى ملف JSON (M-22). المفتاح ثابت `default`.
model DeveloperPortalBackup {
  id        String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

/// إقرارات ضريبية ربع سنوية — تخزين محلي (M-23).
model TaxDeclaration {
  id               String   @id @default(cuid())
  quarter          String
  year             Int
  filingDate       String
  declarationType  String
  taxableSales     Float    @default(0)
  taxablePurchases Float    @default(0)
  salesTax         Float    @default(0)
  purchaseTax      Float    @default(0)
  netTaxPayable    Float    @default(0)
  status           String   @default("مسودة")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// سجلات ضريبة الاستقطاع — تخزين محلي (M-23).
model WithholdingEntry {
  id               String   @id @default(cuid())
  supplier         String
  invoiceNo        String   @default("")
  amount           Float    @default(0)
  withholdingRate  Float    @default(0)
  withheldAmount   Float    @default(0)
  paymentStatus    String   @default("غير مدفوع")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// صلاحيات الخزائن — تخزين محلي (M-23).
model VaultPermission {
  id          String   @id @default(cuid())
  employeeId  String
  vaultId     String
  canDeposit  Boolean  @default(false)
  canWithdraw Boolean  @default(false)
  canView     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, vaultId])
}